            else :
                self.auto_run = False

        def onAuto ( self, event ) :
            rb = event.GetEventObject ()
            lab = rb.GetLabel ()
            print ( "Radio Auto EVENT ****************** ", lab )
            #val = rb.GetValue ()    # is always true
            if lab.startswith ( 'Au' ) :
                self.data.auto ()
            else :
