        # called by button or at 1Hz when autorun
        def new_scan ( self ) :
            if self.spec.ser == None :
                return

            if self.busy :
                print ( "Busy" )
                return

            self.busy = True
            vals = self.spec.bscan ()
            if vals == None or len(vals) != 2048 :
                if vals != None :
                    print ( "Scan yielded : ", len(vals), " values" )
                print ( "Graph update skipped" )
            else :
                self.left.new_data ( vals )
                self.update ()
            self.busy = False

        # Used to capture single scans
        def onRead ( self, event ) :
            #print ( "Time for me to read" )
            if self.auto_run :
                print ( "Already running on auto" )
            else :
                self.new_scan ()

        # Used when weird things happen
        def onRecover ( self, event ) :
            print ( "Recover button was pushed" )
            #self.auto_run = False
            self.spec.finish ()
            self.spec = self.initSpectrometer ()

        # Called at 1 Hz
        def timer_update ( self, event ) :
            #print ( "Tick" )
            if self.auto_run :
                self.new_scan ()

        def update ( self ) :
            #print ( "update Right" )
            self.t_min.SetLabel ( f"Min {self.data.min}" )
            self.t_max.SetLabel ( f"Max {self.data.max}" )


